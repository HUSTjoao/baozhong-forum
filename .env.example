# Local development uses prisma/dev.db; no database service is required.
DATABASE_PROVIDER=sqlite
NEXTAUTH_URL=http://localhost:3000
# Generate a random secret for your .env file.
NEXTAUTH_SECRET=

# To use PostgreSQL, set DATABASE_PROVIDER=postgresql and DATABASE_URL,
# then regenerate the Prisma client and apply the PostgreSQL schema.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
